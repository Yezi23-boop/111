* text=auto eol=lf

# Keep repo metadata, source, docs, scripts, and deployment files stable as LF.
.gitattributes text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.hpp text eol=lf
*.S text eol=lf
*.s text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.service text eol=lf
*.sh text eol=lf

# Binary assets must not be line-ending normalized.
*.bin binary
*.elf binary
*.map binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
