{
  "version": "watch-v1",
  "owner": "server/watch_voice_endpoint",
  "description": "AI Memory Watch device-facing contract for ESP32-S3 firmware integration.",
  "auth": {
    "type": "bearer_device_token",
    "header": "Authorization",
    "format": "Bearer <device_token>",
    "device_secret_scope": "ESP32 may store device_token only; Hermes API keys stay on the server."
  },
  "endpoints": {
    "health": {
      "method": "GET",
      "path": "/v1/watch/health",
      "query": ["device_id"],
      "private_health_required": false
    },
    "voice_command": {
      "method": "POST",
      "path": "/v1/watch/voice-command",
      "content_type": "multipart/form-data",
      "audio_field": "audio",
      "audio_format": "Ogg Opus"
    },
    "text_command": {
      "method": "POST",
      "path": "/v1/watch/text-command",
      "content_type": "multipart/form-data",
      "text_field": "text"
    },
    "cancel": {
      "method": "POST",
      "path": "/v1/watch/request/{request_id}/cancel",
      "content_type": "multipart/form-data"
    },
    "internal_inbox_create": {
      "method": "POST",
      "path": "/internal/watch/inbox",
      "content_type": "application/json",
      "caller": "hermes_server",
      "auth": "Bearer <WATCH_INTERNAL_API_KEY>",
      "note": "Hermes 主动提示写入；使用独立 server-to-server credential，不向 ESP32 或 Cloudflare 公网暴露。"
    },
    "inbox_list": {
      "method": "GET",
      "path": "/v1/watch/inbox",
      "query": ["device_id"],
      "caller": "esp32_watch",
      "note": "手表轮询拉取最近 20 条完整快照；空列表返回 200 + items=[]，不返回 404。"
    },
    "inbox_mark_read": {
      "method": "POST",
      "path": "/v1/watch/inbox/{notification_id}/read",
      "query": ["device_id"],
      "caller": "esp32_watch",
      "note": "幂等；目标不存在返回 404，ESP32 视为终态不再重试该条。"
    }
  },
  "request": {
    "request_id_pattern": "^[A-Za-z0-9._:-]{1,96}$",
    "request_id_format": "<device_id>-<boot_id>-<seq>",
    "boot_id_format": "32-bit random hex generated on boot",
    "seq_format": "monotonic counter within one boot",
    "max_audio_bytes": 6291456,
    "max_text_chars": 240,
    "voice_command_fields": [
      "request_id",
      "device_id",
      "audio",
      "clarification_id",
      "battery_percent",
      "charging",
      "rssi",
      "firmware_version",
      "locale",
      "timezone",
      "source",
      "ui_state"
    ],
    "text_command_fields": [
      "request_id",
      "device_id",
      "text",
      "clarification_id",
      "battery_percent",
      "charging",
      "rssi",
      "firmware_version",
      "locale",
      "timezone",
      "source",
      "ui_state"
    ],
    "locale": "zh-CN",
    "timezone": "Asia/Shanghai",
    "source": "watch_hermes_page"
  },
  "response": {
    "required": [
      "request_id",
      "status",
      "action",
      "asr_text",
      "reply_text",
      "clarification_id",
      "error_code"
    ],
    "additional_properties": false,
    "status_enum": ["done", "error", "timeout", "canceled"],
    "action_enum": [
      "memory_saved",
      "reminder_created",
      "question_answered",
      "clarification_needed",
      "no_action",
      "error"
    ],
    "reply_max_chars": 80
  },
  "timeouts": {
    "watch_wait_seconds": 120,
    "server_request_timeout_seconds": 115,
    "recording_max_seconds": 30,
    "recording_min_seconds": 0.5
  },
  "idempotency": {
    "key": "device_id + request_id",
    "completed_retry": "return_cached_watch_json",
    "inflight_retry": "wait_same_task",
    "canceled_retry": "return_status_canceled_action_no_action",
    "cancel_after_completion": "return_completed_result"
  },
  "security": {
    "esp32_must_not_store": ["HERMES_API_KEY", "API_SERVER_KEY", "XIAOMI_API_KEY"],
    "esp32_must_not_call": ["Hermes Dashboard", "Hermes API Server"],
    "public_proxy_scope": "/v1/watch/*",
    "internal_paths_must_not_be_public": ["/internal/watch/inbox"]
  },
  "inbox": {
    "description": "Hermes 收件箱。V1 使用 SQLite 持久化，每设备最近保留 20 条。",
    "source_fixed": "hermes",
    "max_items_per_device": 20,
    "kind_enum": ["reminder", "info", "warning"],
    "field_byte_limits_utf8": {
      "notification_id": 63,
      "kind": 23,
      "title": 63,
      "preview": 127,
      "body": 383
    },
    "required_fields_on_create": ["notification_id", "kind", "title", "preview", "body"],
    "immutable_after_create": ["notification_id", "kind", "title", "preview", "body", "source", "created_at"],
    "idempotency": {
      "key": "device_id + notification_id",
      "first_create": "201 Created, created=true",
      "duplicate_create": "200 OK, created=false, returns existing item"
    },
    "errors": {
      "422": "字段缺失、空白、超字节限制或 kind 非法",
      "401": "internal create 缺少 internal token，或设备读接口缺少 bearer token",
      "403": "internal token 无效，或设备读接口 device_not_allowed / invalid_device_token",
      "404": "inbox_mark_read 目标消息不存在或已被淘汰"
    },
    "list_response": {
      "order": "created_at DESC",
      "fields": ["notification_id", "source", "kind", "created_at", "title", "preview", "body", "read"],
      "empty": "200 OK, items=[], unread_count=0"
    },
    "read_mark": {
      "idempotent": true,
      "not_found": "404；ESP32 视为终态，移出待同步集合"
    },
    "log_policy": "只记录 endpoint/device_id/notification_id/kind/created/error；禁止记录 Authorization/token/title/preview/body"
  }
}
