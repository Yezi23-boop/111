HERMES_API_URL=http://host.docker.internal:8642
HERMES_API_KEY=replace-with-hermes-api-server-key
HERMES_MODEL=hermes-agent
HERMES_TIMEOUT_SECONDS=120
HERMES_RUN_TIMEOUT_SECONDS=3600
HERMES_RUN_POLL_INTERVAL_SECONDS=1
WATCH_REQUEST_TIMEOUT_SECONDS=115
WATCH_DEVICE_TOKENS=watch-001=replace-with-device-token
WATCH_INTERNAL_API_KEY=replace-with-internal-server-key
WATCH_HTTP_ASYNC_RUNS_ENABLED=true
WATCH_CONVERSATION_SUFFIX=ai-memory-watch
WATCH_REQUEST_CACHE_LIMIT=256
WATCH_CANCELED_REQUEST_LIMIT=1024
WATCH_WS_ENABLED=false
WATCH_WS_MAX_MESSAGE_BYTES=6291456
WATCH_ASR_PROVIDER=mock
WATCH_MOCK_ASR_TEXT=记一下明天看电池日志
WATCH_MAX_AUDIO_BYTES=6291456
WATCH_REPLY_MAX_UTF8_BYTES=120
WATCH_ASR_MAX_UTF8_BYTES=255
MIMO_ASR_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_ASR_API_KEY=replace-with-mimo-api-key
MIMO_ASR_MODEL=mimo-v2.5-asr
MIMO_ASR_LANGUAGE=auto
MIMO_ASR_TIMEOUT_SECONDS=60
MIMO_ASR_TRANSCODE_TIMEOUT_SECONDS=20
